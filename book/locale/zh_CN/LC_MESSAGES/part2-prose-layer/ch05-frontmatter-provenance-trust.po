#: ../../part2-prose-layer/ch05-frontmatter-provenance-trust.md:238
#: 4060f820e0734e129cce998b234ac45f
msgid "The prose-layer reference implementation"
msgstr "文稿层参考实现"

#: ../../part2-prose-layer/ch05-frontmatter-provenance-trust.md:238
#: 829ee03ac0894fc79f3bd2043be8484c
msgid "YAML frontmatter + Git commit SHA + `PKB-metadata` footer"
msgstr "YAML frontmatter + Git commit SHA + `PKB-metadata` footer"

#: ../../part2-prose-layer/ch05-frontmatter-provenance-trust.md:238
#: c7c664358e5d4136a0886872bf7c6d72
msgid "Enforced in `MergeFrontmatterUpdate`."
msgstr "由 `MergeFrontmatterUpdate` 强制执行。"

