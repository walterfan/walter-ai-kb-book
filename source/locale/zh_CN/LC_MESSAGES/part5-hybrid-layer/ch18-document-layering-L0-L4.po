msgstr "`updated_by` ∈ {`human`, `ai`, `ai+human`} —— * 当前版本是谁写的？ *"

#: ../../part5-hybrid-layer/ch18-document-layering-L0-L4.md:83
#: 412a34dc106841cb95ec98aa15d17712
#, python-brace-format
msgid "`review_status` ∈ {`pending`, `approved`} — *has a human signed off?*"
msgstr "`review_status` ∈ {`pending`, `approved`} —— * 有人签过字了吗？ *"

#: ../../part5-hybrid-layer/ch18-document-layering-L0-L4.md:85
#: b8f46b6fb036452b98b0ab89834b17c5
msgid ""
"`review_score` ∈ [0, 5] — *how good is it, in the reviewer's judgement?*"
msgstr "`review_score` ∈ [0, 5] —— * 在评审者的判断里，它有多好？ *"

