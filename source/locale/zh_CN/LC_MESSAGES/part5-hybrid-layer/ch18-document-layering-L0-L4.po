#~ "    base   = vector_score(page, query)       # cosine, etc.\n"
#~ "    L_w    = tier_weight(page.layer)          # e.g. L0=1.0 … L4=0.4\n"
#~ "    R_w    = 1.0 if page.review_status == approved else 0.4\n"
#~ "    S_w    = max(0.5, page.review_score / 5)\n"
